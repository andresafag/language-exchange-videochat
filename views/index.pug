doctype html
html(lang="es")
  head
    title= titulo
    link(rel="stylesheet", href="https://googleapis.com")
    link(rel="stylesheet", href="https://speakswap-website.s3.us-east-1.amazonaws.com/style.css")
    link(rel="icon", type="image/png", href="https://speakswap-website.s3.us-east-1.amazonaws.com/languages.png")
  body
    block content
    
    h1 Choose a room to join 
      span#typed-text
    
    .container
      each sala in salas
        div(
          class=`card card-${sala.id}` 
          onclick=`abrirModal('${sala.id}')`  
          style="cursor:pointer"
        )
          div.card-image(style=`background-image: url(${sala.img})`)
          div.card-content
            h2= sala.nombre
    div#nameModal.modal-overlay
      div.modal-content
        h3 Configura tu Perfil
        p Introduce tu nombre para unirte a la videollamada:
        input#userInput.modal-input(type="text", placeholder="Tu nombre o alias...", maxlength="20")
        div.modal-buttons
          button.btn.btn-secondary(onclick="cerrarModal()") Cancelar
          button.btn.btn-primary(onclick="confirmarIngreso()") Unirse a la Sala

  script(src="https://unpkg.com/typed.js@2.1.0/dist/typed.umd.js")
  script(src="https://speakswap-website.s3.us-east-1.amazonaws.com/script.js")
