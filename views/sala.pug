doctype html
html
  head
    title Sala #{sala.nombre}
    link(rel="stylesheet", href="https://speakswap-website.s3.us-east-1.amazonaws.com/style.css")
  body
    - const roomId = sala.id
    if (roomId === "en")
      h1 Room: English
    else if (roomId === "hi")
      h1 कमरा : हिन्दी 
    else if (roomId === "zh")
      h1 房间: 中文
    else if (roomId === "es")
      h1 Sala: Español
    else if (roomId === "fr")
      h1 Chambre: Francais 

    button.btn-leave(onclick="window.location.href='/'") Volver al Inicio
    #video-grid

    script.
      const LIVEKIT_TOKEN = "!{token}";
      const LIVEKIT_URL = "!{livekitUrl}";
  
      // 2. Cargamos el archivo LOCAL que acabamos de copiar (Cero dependencias de CDN externos)
    script(src="https://speakswap-website.s3.us-east-1.amazonaws.com/js/livekit-client.umd.js")
    script.
        // Validamos dinámicamente cualquier variante de mayúsculas que use el bundle
        const livekitSDK = window.LivekitClient || window.LiveKitClient;
  
        if (!livekitSDK) {
          alert("Error: El archivo local de LiveKit no se cargó correctamente. Revisa la ruta.");
        }
        else {
          console.log("good")
        }
        const { Room, RoomEvent } = livekitSDK;
        let activeRoom = null;
        // Función auxiliar para renderizar las ventanas de video
        function createVideoElement(track, participantIdentity, isLocal = false) {
          const grid = document.getElementById('video-grid');
          
          const container = document.createElement('div');
          container.className = 'video-container';
          container.id = `container-${participantIdentity}`;
  
          const videoEl = track.attach();
          if (isLocal) videoEl.style.transform = 'scaleX(-1)'; // Efecto espejo para el usuario local
  
          const tag = document.createElement('div');
          tag.className = 'username-tag';
          tag.innerText = isLocal ? `${participantIdentity} (Tú)` : participantIdentity;
  
          container.appendChild(videoEl);
          container.appendChild(tag);
          if (isLocal) {
            const controlsDiv = document.createElement('div');
            controlsDiv.className = 'local-controls';

            // Botón de Micrófono
            const micBtn = document.createElement('button');
            micBtn.className = 'control-btn mic-on';
            micBtn.innerHTML = '🎤'; // Icono básico, puedes usar FontAwesome después
            micBtn.onclick = () => toggleMic(micBtn);

            // Botón de Cámara
            const camBtn = document.createElement('button');
            camBtn.className = 'control-btn cam-on';
            camBtn.innerHTML = '📷';
            camBtn.onclick = () => toggleCam(camBtn);

            controlsDiv.appendChild(micBtn);
            controlsDiv.appendChild(camBtn);
            container.appendChild(controlsDiv);
          }
          grid.appendChild(container);
        }

        async function toggleMic(button) {
          if (!activeRoom) return;
          const isMicEnabled = activeRoom.localParticipant.isMicrophoneEnabled;


          try {
            if (!isMicEnabled) {
              // Si estaba apagado, lo encendemos de forma nativa
              await activeRoom.localParticipant.setMicrophoneEnabled(true);
              button.innerHTML = '🎤';
              button.className = 'control-btn mic-on';
              console.log("Micrófono encendido con éxito");
            } else {
              // Si estaba encendido, lo apagamos de forma nativa
              await activeRoom.localParticipant.setMicrophoneEnabled(false);
              button.innerHTML = '🔇';
              button.className = 'control-btn mic-off';
              console.log("Micrófono silenciado con éxito");
            }
          } catch (error) {
            console.error("Error al cambiar el estado del micrófono:", error);
          }
        }

        // Lógica nativa de LiveKit para apagar/encender Cámara
        async function toggleCam(button) {
          if (!activeRoom) return;
          const isCamEnabled = activeRoom.localParticipant.isCameraEnabled;

          try {
            if (!isCamEnabled) {
              // Si estaba apagada, la encendemos de forma nativa
              await activeRoom.localParticipant.setCameraEnabled(true);
              button.innerHTML = '📷';
              button.className = 'control-btn cam-on';
              console.log("Cámara encendida con éxito");
            } else {
              // Si estaba encendida, la apagamos de forma nativa
              await activeRoom.localParticipant.setCameraEnabled(false);
              button.innerHTML = '❌'; 
              button.className = 'control-btn cam-off';
              console.log("Cámara apagada con éxito");
            }
          } catch (error) {
            console.error("Error al cambiar el estado de la cámara:", error);
          }
        }
  
        async function joinVideoChat() {
          // Inicializamos la configuración de la sala
          const room = new Room({ adaptiveStream: true, dynacast: true });
          activeRoom = room

          room.on(RoomEvent.AudioPlaybackStatusChanged, () => {
          // Si el navegador bloqueó la reproducción automática de sonido de los demás...
          if (!room.canPlaybackAudio) {
            console.warn("El navegador bloqueó el audio entrante. Solicitando interacción...");

            // Creamos un banner o aviso discreto flotante en la pantalla para obligar a dar un clic
            const audioBanner = document.createElement('div');
            audioBanner.id = 'audio-start-banner';
            audioBanner.style = "position: fixed; top: 10px; left: 50%; transform: translateX(-50%); background: #f04747; color: white; padding: 12px 24px; border-radius: 8px; font-weight: bold; z-index: 9999; cursor: pointer; box-shadow: 0 4px 15px rgba(0,0,0,0.5);";
            audioBanner.innerText = "🔊 Haz clic aquí para activar el audio de los participantes";

            // Al hacer clic en el banner, disparamos el desbloqueo nativo del WebRTC del navegador
            audioBanner.onclick = async () => {
              try {
                await room.startAudio(); // <-- Método oficial de LiveKit para forzar el sonido
                console.log("Audio activado exitosamente.");
                audioBanner.remove(); // Eliminamos el aviso una vez suene la sala
              } catch (err) {
                console.error("No se pudo iniciar el canal de audio:", err);
              }
            };

            document.body.appendChild(audioBanner);
          }
        });
  
          // Evento: Se ejecuta cuando otro participante enciende su cámara
          room.on(RoomEvent.TrackSubscribed, (track, publication, participant) => {
            if (track.kind === 'video') {
              createVideoElement(track, participant.identity, false);
            }
            if (track.kind === 'audio') {
              console.log(`Recibiendo canal de audio de: ${participant.identity}`);
              const audioEl = track.attach();
              document.body.appendChild(audioEl);
            }
          });
  
          // Evento: Se ejecuta cuando un participante apaga la cámara o abandona la sala
          room.on(RoomEvent.TrackUnsubscribed, (track, publication, participant) => {
            track.detach();
            const container = document.getElementById(`container-${participant.identity}`);
            if (container) container.remove();
          });
  
          // Conexión al backend de LiveKit Docker en tu instancia EC2
          await room.connect(LIVEKIT_URL, LIVEKIT_TOKEN);
          console.log("Conectado con éxito a LiveKit!");
  
          // Activamos cámara y micrófono locales e inyectamos nuestro feed
          const videoPublication = await room.localParticipant.setCameraEnabled(true);
          await room.localParticipant.setMicrophoneEnabled(true);
          console.log('Cámara y Micrófono activados');          
          const localVideoTrack = videoPublication.videoTrack;
          if (localVideoTrack) {
            createVideoElement(localVideoTrack, room.localParticipant.identity, true);
          }
        }
  
        // Iniciamos el flujo automático de conexión
        joinVideoChat().catch(console.error);

    