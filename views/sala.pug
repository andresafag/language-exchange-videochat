doctype html
html
  head
    title Sala #{sala.nombre}
    link(rel="stylesheet", href="https://speakswap-website.s3.us-east-1.amazonaws.com/public/style.css")
  body
    - const roomId = sala.id
    if (roomId === "en")
      h1 Room: English
    else if (roomId === "hi")
      h1 कमरा : हिन्दी 
    else if (roomId === "zh")
      h1 房间: 中文
    else if (roomId === "es")
      h1 Sala: Español
    else if (roomId === "fr")
      h1 Chambre: Francais 
    #video-grid

  script(type="module" src="https://speakswap-website.s3.us-east-1.amazonaws.com/public/js/main.js")

    