doctype html
html
  head
    title Sala #{sala.nombre}
    link(rel="stylesheet", href="https://speakswap-website.s3.us-east-1.amazonaws.com/public/style.css")
    script(src="/socket.io/socket.io.js")
    script(src="https://speakswap-website.s3.us-east-1.amazonaws.com/peerjs.min.js")
  body
    h1 Sala: #{sala.nombre}
    #video-grid

    script.
      const peers = {}; // Objeto para rastrear las llamadas activas

      window.onload = function() {
        if (typeof io === 'undefined') return console.error("Socket.io no cargó");

        const videoGrid = document.getElementById('video-grid');
        const socket = io({ transports: ['websocket'], upgrade: false });
        const myPeer = new Peer(undefined, {
          config: {
            'iceServers': [
              { url: 'stun:://google.com' },
              { url: 'stun:://google.com' }
            ]
          }
        }); 

        myPeer.on('open', (id) => {
          console.log('✅ Mi Peer ID:', id);
          socket.emit('join-room', "#{sala.id}", id);
        });

        // 1. Obtener Cámara y Micrófono
        navigator.mediaDevices.getUserMedia({ video: true, audio: true })
          .then((stream) => {
            const myVideo = document.createElement('video');
            myVideo.muted = true; // Silenciamos nuestro propio video para evitar eco
            addVideoStream(myVideo, stream, "Yo", "local-user");

            // Responder llamadas entrantes
            myPeer.on('call', (call) => {
              call.answer(stream);
              const video = document.createElement('video');
              call.on('stream', (userStream) => {
                addVideoStream(video, userStream, "Invitado", call.peer);
              });
              call.on('close', () => {
                video.closest('.video-container').remove();
              });
            });

            // Conectar con nuevos usuarios
            socket.on('user-connected', (userId) => {
              console.log('Conectando a nuevo usuario:', userId);
              if (!document.getElementById(userId)) {
                setTimeout(() => {
                  const call = myPeer.call(userId, stream);
                  const video = document.createElement('video');
                  
                  call.on('stream', (userStream) => {
                    addVideoStream(video, userStream, "Conectado", userId);
                  });

                  call.on('close', () => {
                    const el = document.getElementById(userId);
                    if (el) el.remove();
                  });

                  peers[userId] = call;
                }, 1500);
              }
            });
          })
          .catch((err) => console.error('Error acceso multimedia:', err));

        // 2. Escuchar desconexión desde el servidor
        socket.on('user-disconnected', (userId) => {
          console.log('Usuario desconectado:', userId);
          if (peers[userId]) {
            peers[userId].close();
            delete peers[userId];
          }
          const el = document.getElementById(userId);
          if (el) el.remove();
        });

        // 3. Función para añadir video y activar el monitor de voz
        function addVideoStream(video, stream, nombre, userId) {
          if (userId && document.getElementById(userId)) return;

          video.srcObject = stream;
          video.autoplay = true;
          video.playsInline = true;
          
          video.onloadedmetadata = () => {
            video.play().catch(e => console.error("Error play:", e));
          };

          const div = document.createElement('div');
          div.className = 'video-container';
          if (userId) div.id = userId; 
          
          const p = document.createElement('p');
          p.innerText = nombre;
          
          div.append(video);
          div.append(p);
          videoGrid.append(div);

          // Iniciar detector de voz si el stream tiene audio
          if (stream.getAudioTracks().length > 0) {
            monitorizarVolumen(stream, userId);
          }
        }

        // 4. Analizador de Audio para la franja verde
        function monitorizarVolumen(stream, elementId) {
          try {
            const audioContext = new (window.AudioContext || window.webkitAudioContext)();
            const analyser = audioContext.createAnalyser();
            const source = audioContext.createMediaStreamSource(stream);
            source.connect(analyser);

            analyser.fftSize = 512;
            const bufferLength = analyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);

            function verificar() {
              analyser.getByteFrequencyData(dataArray);
              let sum = 0;
              for (let i = 0; i < bufferLength; i++) {
                sum += dataArray[i];
              }
              const promedio = sum / bufferLength;
              const contenedor = document.getElementById(elementId);

              if (contenedor) {
                // Ajusta el '30' según la sensibilidad deseada
                if (promedio > 30) {
                  contenedor.classList.add('speaking');
                } else {
                  contenedor.classList.remove('speaking');
                }
              }
              requestAnimationFrame(verificar);
            }
            verificar();
          } catch (e) {
            console.error("Error en AudioContext:", e);
          }
        }
      };
